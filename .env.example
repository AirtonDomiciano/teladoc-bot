# Copie para .env. O JSON continua obrigatório para o mapeamento das colunas.
# O bot lê estas variáveis e também aceita AZURE_DEVOPS_PAT no lugar de AZURE_PAT.
# Organização e projeto saem do link da US.

# Planilha local
PLANILHA_PATH=/media/projetos/teladoc/telas.xlsx
PLANILHA_ABA=Telas

# Clone local do RetaguardaWeb
RETAGUARDA_PATH=/media/projetos/IMEX/WEB/RetaguardaWeb/RetaguardaWeb_angular-client

# Azure DevOps
AZURE_ORGANIZATION=https://dev.azure.com/metanetsistema
AZURE_PROJECT=Metanet
AZURE_PAT=

# Google Sheets opcional. Com GOOGLE_SPREADSHEET_ID vazio, a fonte continua sendo o Excel.
# credentials.json é o cliente OAuth de aplicativo para computador.
# token.json é gerado na primeira autorização e reutilizado depois.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=TELAS DE CADASTRO
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_TOKEN_PATH=token.json